# Development files: needed to build, not shipped in the release ZIP
# (composer release removes every path marked export-ignore).
# Directories are matched as dir/** so the attribute applies to the files inside.
/.gitattributes export-ignore
/.gitignore export-ignore
@@if ci
/.github/** export-ignore
@@endif
@@if quality
/.php-cs-fixer.dist.php export-ignore
/eslint.config.cjs export-ignore
/phpstan.dist.neon export-ignore
@@endif
/README.md export-ignore
@@if e2e
/tests/** export-ignore
@@endif
/webpack.config.js export-ignore
