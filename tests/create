#!/usr/bin/env bash
# Creates a project from this checkout of the starter without interaction, as
# `composer create-project saij/wp-app-starter <slug> --no-interaction` would, with the
# framework checkout instead of a release from Packagist. The starter, wp-app-framework
# and wp-test-env lie next to each other in one directory, the workspace of wp-test-env;
# the project is created there as <slug> (an existing directory is replaced).
#
# Usage: tests/create <slug> <theme|child-theme|plugin> [NAME=value]...
#
# NAME=value are further answers (WP_APP_STARTER_<NAME>, see installer/Questions.php),
# e.g. EXAMPLE=no or PARENT=my-theme. Defaults: package acme/<slug>, namespace = the
# slug without "_" and the default answers of the installer (every option yes).
set -euo pipefail

[[ $# -ge 2 ]] || { echo "Usage: tests/create <slug> <theme|child-theme|plugin> [NAME=value]..." >&2; exit 2; }
slug="$1"
kind="$2"
shift 2

starter="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
workspace="$(dirname "${starter}")"
tools="${workspace}/wp-test-env/bin/tools"
[[ -x "${tools}" ]] || { echo "ERROR: wp-test-env is not checked out next to the starter (${tools})." >&2; exit 1; }
[[ -d "${workspace}/wp-app-framework" ]] || { echo "ERROR: wp-app-framework is not checked out next to the starter." >&2; exit 1; }

# The framework checkout stands in for the version the starter requires (^0.16 → 0.16.0).
constraint="$(sed -n 's/.*"saij\/wp-app-framework": *"\([^"]*\)".*/\1/p' "${starter}/composer.json")"
[[ "${constraint}" =~ ^\^([0-9]+\.[0-9]+)$ ]] || { echo "ERROR: cannot derive a version from the constraint '${constraint}'." >&2; exit 1; }
version="${BASH_REMATCH[1]}.0"

# A Composer home of its own: its repositories apply to create-project and to the
# composer update the installer runs.
home="${workspace}/.starter-composer"
mkdir -p "${home}"
# Written atomically: tests/projects creates several projects at the same time.
config="$(mktemp "${home}/config.json.XXXXXX")"
cat > "${config}" <<JSON
{
    "repositories": [
        {"type": "path", "url": "/workspace/wp-app-framework", "options": {"symlink": true, "versions": {"saij/wp-app-framework": "${version}"}}},
        {"type": "path", "url": "/workspace/$(basename "${starter}")", "options": {"symlink": false, "versions": {"saij/wp-app-starter": "0.0.0"}}}
    ]
}
JSON
mv "${config}" "${home}/config.json"

environment=(
    -e "COMPOSER_HOME=/workspace/.starter-composer"
    # A cache of its own per project: tests/projects creates several at the same time, and
    # Composer reads a package ZIP from a shared cache while another process still writes it.
    -e "COMPOSER_CACHE_DIR=/workspace/.starter-composer/cache/${slug}"
    -e "WP_APP_STARTER_KIND=${kind}"
    -e "WP_APP_STARTER_PACKAGE=acme/${slug}"
    -e "WP_APP_STARTER_NAMESPACE=${slug//_/}"
)
for answer in "$@"; do
    [[ "${answer}" =~ ^[A-Z0-9_]+=.*$ ]] || { echo "ERROR: answers are NAME=value, got '${answer}'." >&2; exit 2; }
    environment+=(-e "WP_APP_STARTER_${answer}")
done

rm -rf "${workspace:?}/${slug}"
"${tools}" "${environment[@]}" composer create-project saij/wp-app-starter "${slug}" 0.0.0 --no-interaction --no-progress
