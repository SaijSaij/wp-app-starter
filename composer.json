{
    "name": "webcodingcat/wp-app-starter",
    "description": "Creates a theme, child theme or plugin built with wp-app-framework: composer create-project webcodingcat/wp-app-starter <directory>.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "keywords": ["wordpress", "theme", "plugin", "block", "starter"],
    "require": {
        "php": ">=8.5",
        "webcodingcat/wp-app-framework": "^0.20"
    },
    "autoload": {
        "psr-4": {
            "WebCodingCat\\WpAppStarter\\": "installer/"
        }
    },
    "scripts": {
        "post-create-project-cmd": "WebCodingCat\\WpAppStarter\\Installer::run"
    },
    "config": {
        "platform": {
            "php": "8.5"
        },
        "platform-check": false,
        "sort-packages": true
    }
}
